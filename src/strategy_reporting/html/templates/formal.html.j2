<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta http-equiv="Content-Security-Policy" content="{{ csp }}"><title>{{ model.title }}</title><style>{{ stylesheet }}</style></head><body class="{{ theme }}"><main><header><div class="eyebrow">Strategy Reporting · Formal Run</div><h1>{{ model.title }}</h1><div class="muted">{{ model.subject.workspace_run_id }} · {{ model.subject.formal_id }} · {{ model.engine.engine_name }} {{ model.engine.engine_version }}</div></header>
<section><h2>身份与结论</h2><div class="grid"><div class="card"><div class="muted">结果</div><div class="value">{{ model.subject.outcome }}</div></div><div class="card"><div class="muted">拓扑</div><div class="value">{{ model.subject.topology }}</div></div><div class="card"><div class="muted">快照</div><div class="value">{{ model.market.snapshot_id }}</div></div><div class="card"><div class="muted">参数哈希</div><div class="value">{{ model.strategy.parameters_hash }}</div></div></div></section>
<section><h2>Nautilus 原生指标</h2><div class="grid">{% for group, values in metric_groups %}{% for name, value in values.items() %}<div class="card"><div class="muted">{{ group }} · {{ name }}</div><div class="value">{{ value }}</div></div>{% endfor %}{% endfor %}</div>{% if not model.performance.portfolio_returns %}<div class="notice">收益序列为空；原生 tearsheet 会显示合法空态。</div>{% endif %}</section>
{% for name, label, preview in execution_sections %}<section><h2>{{ label }}</h2><div class="muted">共 {{ preview.total_rows }} 行，展示 {{ preview.rows|length }} 行，省略 {{ preview.omitted_count }} 行。</div>{% if preview.rows %}<table><thead><tr>{% for key in preview.rows[0].keys() %}<th>{{ key }}</th>{% endfor %}</tr></thead><tbody>{% for row in preview.rows %}<tr>{% for value in row.values() %}<td>{{ value }}</td>{% endfor %}</tr>{% endfor %}</tbody></table>{% else %}<div class="notice">没有已发布记录。</div>{% endif %}</section>{% endfor %}
<section><h2>运行与账户</h2><div class="grid"><div class="card"><h3>Run info</h3><pre>{{ run_info }}</pre></div><div class="card"><h3>Account info</h3><pre>{{ account_info }}</pre></div></div></section><section><h2>数据质量与来源</h2><pre>{{ quality }}</pre><div class="muted">原生交互 tearsheet 作为同一 publication 的独立 artifact 发布。</div></section><footer>本报告只展示 Workspace 中已验证的已发布事实，不重新计算 Nautilus 指标。</footer></main></body></html>
