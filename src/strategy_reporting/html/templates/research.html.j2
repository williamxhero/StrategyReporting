<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta http-equiv="Content-Security-Policy" content="{{ csp }}"><title>{{ model.title }}</title><style>{{ stylesheet }}</style></head><body class="{{ theme }}"><main><header><div class="eyebrow">Strategy Reporting · Research Study</div><h1>{{ model.title }}</h1><div class="muted">{{ model.subject.study_id }} · decision {{ model.subject.decision_id }}</div></header>
<section><h2>研究结论</h2><div class="grid"><div class="card"><div class="muted">Decision</div><div class="value {{ 'good' if model.final_decision.status == 'accept' else 'bad' }}">{{ model.final_decision.status }}</div></div><div class="card"><div class="muted">Trials</div><div class="value">{{ model.trials|length }}</div></div><div class="card"><div class="muted">Protocol</div><div class="value">{{ model.subject.protocol_hash }}</div></div></div><h3>研究假设</h3><p>{{ model.hypothesis }}</p></section>
<section><h2>Protocol 与门槛</h2><pre>{{ protocol }}</pre><table><thead><tr><th>Gate</th><th>Metric</th><th>Operator</th><th>Threshold</th></tr></thead><tbody>{% for gate in model.gate_specs %}<tr><td>{{ gate.gate }}</td><td>{{ gate.metric }}</td><td>{{ gate.operator }}</td><td>{{ gate.threshold }}</td></tr>{% endfor %}</tbody></table></section>
<section><h2>Trial 时间线</h2>{% for trial, trial_json in trial_views %}<div class="card"><h3>#{{ trial.sequence }} · {{ trial.trial_id }}</h3><div class="muted">{{ trial.workspace_run_id }} · {{ trial.topology }} · {{ trial.run_status }}/{{ trial.result_outcome }}</div><pre>{{ trial_json }}</pre></div>{% endfor %}</section>
<section><h2>Gate matrix</h2>{% for gate in model.gate_results %}<div class="card"><strong>{{ gate.result.gate }}</strong> · <span class="{{ 'good' if gate.result.status == 'pass' else 'bad' }}">{{ gate.result.status }}</span><div class="muted">{{ gate.result.metric }} {{ gate.result.operator }} {{ gate.result.threshold }} · observed {{ gate.result.observed }}</div></div>{% endfor %}</section>
<section><h2>Evidence 与研究指标</h2><pre>{{ evidence }}</pre><pre>{{ metrics }}</pre></section><section><h2>稳健性、敏感性与容量</h2>{% for label, section in sections %}<div class="card"><h3>{{ label }} · {{ section.status }}</h3>{% if section.reason %}<div class="notice">{{ section.reason }}</div>{% endif %}{% if section.items %}<pre>{{ section.items }}</pre>{% endif %}</div>{% endfor %}</section>
<section><h2>关联 Formal reports</h2>{% for link in model.related_formal_reports %}<div class="card"><strong>{{ link.workspace_run_id }}</strong> · {{ link.status }}{% if link.report_ids %}<pre>{{ link.report_ids }}</pre>{% endif %}</div>{% endfor %}</section><footer>研究页只消费 apex-research.study-report-source.v1，不解析 Markdown，不重建 engine metrics。</footer></main></body></html>
